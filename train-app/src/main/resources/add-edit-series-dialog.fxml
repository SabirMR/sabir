<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane alignment="center" hgap="10" vgap="10" xmlns="http://javafx.com/javafx/17"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="com.example.trainapp.controller.series.AddEditSeriesDialog">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20"/>
    </padding>
    <children>
        <Label text="Наименование:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Тип тяги:" GridPane.rowIndex="1"/>
        <TextField fx:id="tractionTypeField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Мощность (кВт):" GridPane.rowIndex="2"/>
        <TextField fx:id="powerKwField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="Макс. скорость (км/ч):" GridPane.rowIndex="3"/>
        <TextField fx:id="maxSpeedField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Label text="Год выпуска серии:" GridPane.rowIndex="4"/>
        <TextField fx:id="yearField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        <Button fx:id="okButton" text="OK" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
        <Label fx:id="errorLabel" textFill="red" GridPane.columnSpan="2" GridPane.rowIndex="6"/>
    </children>
    <columnConstraints>
        <ColumnConstraints/>
        <ColumnConstraints/>
    </columnConstraints>
</GridPane>
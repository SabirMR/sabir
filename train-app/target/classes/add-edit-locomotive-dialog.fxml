<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane alignment="center" hgap="10" vgap="10" xmlns="http://javafx.com/javafx/17"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="com.example.trainapp.controller.locomotive.AddEditLocomotiveDialog">
    <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>
    <children>
        <Label text="Серия:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="seriesCombo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Номер машины:" GridPane.rowIndex="1"/>
        <TextField fx:id="numberField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Статус:" GridPane.rowIndex="2"/>
        <ComboBox fx:id="statusCombo" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="Дата ремонта:" GridPane.rowIndex="3"/>
        <DatePicker fx:id="repairDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Label text="Пробег (км):" GridPane.rowIndex="4"/>
        <TextField fx:id="mileageField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        <Button fx:id="okButton" text="OK" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
        <Label fx:id="errorLabel" textFill="red" GridPane.columnSpan="2" GridPane.rowIndex="6"/>
    </children>
    <columnConstraints><ColumnConstraints/><ColumnConstraints/></columnConstraints>
</GridPane>